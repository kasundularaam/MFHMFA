{
  "name": "mfhmfa",
  "version": "1.0.0",
  "description": "MFHMFA (Mermaid For Humans, Mermaid For Agents) — Eye-comfortable Mermaid chart studio, headless validation/rendering engine, CLI tools, and MCP server.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kasundularaam/MFHMFA.git"
  },
  "homepage": "https://github.com/kasundularaam/MFHMFA#readme",
  "keywords": [
    "mfhmfa",
    "mermaid",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "diagrams",
    "architecture",
    "renderer"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "bin": {
    "mfhmfa": "./bin/mfhmfa",
    "mermaid-studio": "./bin/mermaid-studio"
  },
  "scripts": {
    "dev": "tsx src/dev.ts",
    "build:web": "vite build",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "tsx src/server.ts",
    "mcp": "tsx src/mcp-stdio.ts",
    "tool": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "docker:up": "mkdir -p data && docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:restart": "docker compose restart"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@lezer/highlight": "^1.2.5",
    "@modelcontextprotocol/sdk": "^1.27.0",
    "@uiw/react-codemirror": "^4.23.12",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^0.479.0",
    "mermaid": "^11.12.0",
    "puppeteer-core": "^24.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vitest": "^3.0.8"
  }
}
