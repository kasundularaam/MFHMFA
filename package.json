{
  "name": "mfhmfa",
  "version": "2.0.0",
  "description": "MFHMFA (Mermaid For Humans, Mermaid For Agents) — Stateless Mermaid chart studio, parallel headless validation/rendering engine, REST tool API, and MCP server.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kasundularaam/MFHMFA.git"
  },
  "homepage": "https://github.com/kasundularaam/MFHMFA#readme",
  "keywords": [
    "mfhmfa",
    "mermaid",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "diagrams",
    "architecture",
    "renderer"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx src/dev.ts",
    "build:web": "vite build",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "tsx src/server.ts",
    "mcp": "tsx src/mcp-stdio.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:restart": "docker compose restart",
    "lint": "biome lint src web tests",
    "format": "biome format --write src web tests",
    "check": "biome lint src web tests && npm run typecheck"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@lezer/highlight": "^1.2.5",
    "@modelcontextprotocol/sdk": "^1.27.0",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@uiw/react-codemirror": "^4.23.12",
    "cors": "^2.8.5",
    "dompurify": "^3.4.17",
    "express": "^4.21.2",
    "idb-keyval": "^6.3.0",
    "immer": "^11.2.10",
    "lucide-react": "^0.479.0",
    "mermaid": "^11.12.0",
    "puppeteer-core": "^24.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.25.2",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/cors": "^2.8.17",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vitest": "^3.0.8"
  }
}
